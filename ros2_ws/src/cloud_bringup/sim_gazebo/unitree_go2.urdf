<?xml version="1.0"?>
<!--
  Project Cloud: Unitree Go2 Edu Quadruped URDF
  Includes RealSense D435i, 4D LiDAR, and Gazebo ROS 2 plugins.
-->
<robot name="unitree_go2">

  <!-- Base Link (Chassis) -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="15.0"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.12"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.65 0.31 0.20"/>
      </geometry>
      <material name="chassis_silver">
        <color rgba="0.75 0.77 0.80 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.65 0.31 0.20"/>
      </geometry>
    </collision>
  </link>

  <!-- RealSense D435i Camera Module -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
      <material name="camera_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.325 0.0 0.06" rpy="0 0.14 0"/>
  </joint>

  <!-- 4D LiDAR Sensor -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.045" length="0.04"/>
      </geometry>
      <material name="lidar_dark">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.10 0.0 0.12" rpy="0 0 0"/>
  </joint>

  <!-- Legs (Schematic 4-Point Stance for Kinematic Simulation) -->
  <link name="fl_foot">
    <collision><geometry><sphere radius="0.03"/></geometry></collision>
  </link>
  <joint name="fl_joint" type="fixed">
    <parent link="base_link"/><child link="fl_foot"/><origin xyz="0.22 0.15 -0.32"/>
  </joint>

  <link name="fr_foot">
    <collision><geometry><sphere radius="0.03"/></geometry></collision>
  </link>
  <joint name="fr_joint" type="fixed">
    <parent link="base_link"/><child link="fr_foot"/><origin xyz="0.22 -0.15 -0.32"/>
  </joint>

  <link name="rl_foot">
    <collision><geometry><sphere radius="0.03"/></geometry></collision>
  </link>
  <joint name="rl_joint" type="fixed">
    <parent link="base_link"/><child link="rl_foot"/><origin xyz="-0.22 0.15 -0.32"/>
  </joint>

  <link name="rr_foot">
    <collision><geometry><sphere radius="0.03"/></geometry></collision>
  </link>
  <joint name="rr_joint" type="fixed">
    <parent link="base_link"/><child link="rr_foot"/><origin xyz="-0.22 -0.15 -0.32"/>
  </joint>

  <!-- Gazebo Sensor Simulation Plugins -->
  <gazebo reference="camera_link">
    <sensor name="realsense_d435i" type="camera">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.21</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/cloud</namespace>
          <remapping>image_raw:=camera/rgb/image_raw</remapping>
        </ros>
      </plugin>
    </sensor>
  </gazebo>

</robot>
