<?xml version="1.0" ?>
<!--
  Project Cloud: Master Gazebo World Configuration
  Platform: Unitree Go2 Edu Quadruped
  Target: Gazebo Fortress / Harmonic (ROS 2 Humble)
-->
<sdf version="1.9">
  <world name="dpsi_expo_pavilion">
    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Ambient Illumination -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.22 0.25 1</ambient>
            <diffuse>0.3 0.33 0.38 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Booth 1: Solar Cart Stand with ArUco Marker ID 10 -->
    <model name="booth_01_solar_cart">
      <static>true</static>
      <pose>12.0 0.0 0.0 0 0 3.14159</pose>
      <link name="stand_link">
        <collision name="collision">
          <geometry>
            <box><size>1.2 2.0 0.9</size></box>
          </geometry>
        </collision>
        <visual name="visual_table">
          <geometry>
            <box><size>1.2 2.0 0.9</size></box>
          </geometry>
          <material>
            <ambient>0.15 0.2 0.3 1</ambient>
            <diffuse>0.25 0.35 0.5 1</diffuse>
          </material>
        </visual>
        <!-- ArUco Marker Plate (160mm) -->
        <visual name="aruco_marker_10">
          <pose>0.61 0.0 0.25 0 1.5708 0</pose>
          <geometry>
            <box><size>0.16 0.16 0.005</size></box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Liquid Spill Hazard (Specular Anomaly on Floor) -->
    <model name="liquid_spill_hazard">
      <static>true</static>
      <pose>6.0 0.0 0.002 0 0 0</pose>
      <link name="spill_link">
        <visual name="visual_spill">
          <geometry>
            <cylinder>
              <radius>0.235</radius>
              <length>0.004</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.15 0.3 0.85</ambient>
            <diffuse>0.1 0.3 0.6 0.85</diffuse>
            <specular>0.95 0.95 1.0 1.0</specular>
          </material>
        </visual>
        <collision name="spill_collision">
          <geometry>
            <cylinder>
              <radius>0.235</radius>
              <length>0.004</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.05</mu>
                <mu2>0.05</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <!-- Central Stage Platform (NODE_30) -->
    <model name="stage_platform">
      <static>true</static>
      <pose>0.0 0.0 0.05 0 0 0</pose>
      <link name="stage_link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>2.5</radius>
              <length>0.10</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>2.5</radius>
              <length>0.10</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.15 1</ambient>
            <diffuse>0.2 0.2 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
